<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>cl.artcrate</groupId>
  <artifactId>gateway-service</artifactId>
  <version>1.0.0</version>
  <name>gateway-service</name>
  <description>API Gateway de ArtCrate: única puerta de entrada a los microservicios</description>

  <properties>
    <java.version>21</java.version>
    <!-- Release train de Spring Cloud compatible con Spring Boot 3.5.x (el mismo de los demás servicios) -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <!-- El gateway es REACTIVO (Netty): por eso NO lleva spring-boot-starter-web, solo estas dos dependencias -->
  <dependencies>
    <!-- Spring Cloud Gateway (en el release train 2025.0 el starter se llama "gateway-server-webflux") -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <!-- Cliente Eureka: permite resolver nombres como lb://usuarios-service -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <!-- Swagger UI agregado: el gateway es reactivo (Netty), por eso usa la variante "webflux"
         (los 6 servicios usan "webmvc" porque son Servlet). Junta los 6 swagger de los servicios
         en una sola pantalla: http://localhost:8080/swagger-ui.html -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
      <version>2.8.17</version>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
