{
  "info": {
    "name": "ArtCrate - API de microservicios",
    "description": "Colección para probar ArtCrate a través del API Gateway (http://localhost:8080). Empieza por la carpeta \"0 - Flujo de compra\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Flujo de compra (de punta a punta)",
      "item": [
        {
          "name": "1. Login del cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/usuarios/login"
            },
            "description": "Devuelve el usuario sin contraseña. Guarda su id en la variable usuarioId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@artcrate.cl\",\n  \"password\": \"Cliente123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var datos = pm.response.json();",
                  "pm.collectionVariables.set(\"usuarioId\", datos.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/api/productos"
            }
          }
        },
        {
          "name": "3. Agregar producto 1 x2 al carrito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/carritos/{{usuarioId}}/items"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. Agregar producto 7 x1 al carrito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/carritos/{{usuarioId}}/items"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 7,\n  \"cantidad\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. Cambiar cantidad del producto 1 a 3",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/carritos/{{usuarioId}}/items/1"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Intentar superar el stock (debe dar 409)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/carritos/{{usuarioId}}/items/1"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 9999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/pedidos"
            },
            "description": "Descuenta el stock, guarda el pedido PENDIENTE_PAGO y vacía el carrito. Guarda el id en pedidoId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"direccionDespacho\": \"Av. Providencia 1234\",\n  \"comuna\": \"Providencia\",\n  \"region\": \"Metropolitana de Santiago\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var datos = pm.response.json();",
                  "pm.collectionVariables.set(\"pedidoId\", datos.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Verificar carrito vacío",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/api/carritos/{{usuarioId}}"
            }
          }
        },
        {
          "name": "9. Verificar stock descontado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/api/inventario"
            }
          }
        },
        {
          "name": "10. Pagar el pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/api/pagos"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": \"{{pedidoId}}\",\n  \"metodo\": \"TARJETA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Verificar pedido PAGADO",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/api/pedidos/{{pedidoId}}"
            }
          }
        }
      ],
      "description": "Ejecuta los pasos en orden (Run collection). Requiere Eureka, los 6 servicios y el gateway arriba (run-all.bat)."
    },
